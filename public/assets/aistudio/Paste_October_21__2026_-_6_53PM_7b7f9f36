    <script>
        const GOOGLE_SHEET_API_URL = "https://script.google.com/macros/s/AKfycbyK1y4XW4_SCOP3wsyIEhapnj95mXr-xxLCmVHGtyUB5nGOEjalniPxY-Iml61rn5onug/exec";

        let users = [];
        let leaveRequests = [];
        let attendanceData = [];
        let currentUser = null;
        let currentMainTab = 'report'; 
        let targetLocationInputId = null;
        let mapInstance = null, markerInstance = null, selectedCoords = null;
        let deferredPrompt = null;
        let myAttendanceHistory = []; 

        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            deferredPrompt = e;
            const btn = document.getElementById('installAppBtn');
            if (btn) btn.classList.remove('hidden');
            if (btn) btn.classList.add('inline-flex');
        });

        async function installApp() {
            if (deferredPrompt) {
                deferredPrompt.prompt();
                const { outcome } = await deferredPrompt.userChoice;
                if (outcome === 'accepted') {
                    showToast("អបអរសាទរ! កម្មវិធីត្រូវបានដំឡើងរួចរាល់។", "success");
                }
                deferredPrompt = null;
                document.getElementById('installAppBtn').classList.add('hidden');
            } else {
                showToast("កម្មវិធីនេះត្រូវបានដំឡើងរួច ឬ Browser មិនគាំទ្រ.", "info");
            }
        }

        window.addEventListener('DOMContentLoaded', async () => {
            await fetchUsersFromGoogleSheet();
            await fetchLeavesFromGoogleSheet();
            await fetchAttendanceFromGoogleSheet();
            loadFromStorage();
            checkSession();
            lucide.createIcons();
        });

        async function fetchUsersFromGoogleSheet() {
            try {
                const response = await fetch(`${GOOGLE_SHEET_API_URL}?type=get_users`);
                const data = await response.json();
                if (data && Array.isArray(data)) {
                    users = data;
                    localStorage.setItem('app_users_sheet', JSON.stringify(users));
                }
            } catch (e) {
                const stored = localStorage.getItem('app_users_sheet');
                if (stored) { try { users = JSON.parse(stored); } catch(err){} }
            }
        }

        async function fetchLeavesFromGoogleSheet() {
            try {
                const response = await fetch(`${GOOGLE_SHEET_API_URL}?type=get_leaves`);
                const data = await response.json();
                if (data && Array.isArray(data)) {
                    leaveRequests = data; // យកទិន្នន័យថ្មីស្រឡាងពី Sheet មកជំនួស
                    localStorage.setItem('app_leaves_sheet', JSON.stringify(leaveRequests));
                    renderTableData(); // สั่ง Refresh តារាងឱ្យបង្ហាញទិន្នន័យថ្មី
                }
            } catch (e) {
                const stored = localStorage.getItem('app_leaves_sheet');
                if (stored) { try { leaveRequests = JSON.parse(stored); } catch(err){} }
            }
        }

        async function fetchAttendanceFromGoogleSheet() {
            try {
                const response = await fetch(`${GOOGLE_SHEET_API_URL}?type=get_attendance`);
                const data = await response.json();
                if (data && Array.isArray(data)) {
                    attendanceData = data;
                    localStorage.setItem('app_attendance_sheet', JSON.stringify(attendanceData));
                }
            } catch (e) {
                const stored = localStorage.getItem('app_attendance_sheet');
                if (stored) { try { attendanceData = JSON.parse(stored); } catch(err){} }
            }
        }

        function loadFromStorage() {
            const storedLeaves = localStorage.getItem('app_leaves');
            if (storedLeaves) { try { leaveRequests = JSON.parse(storedLeaves); } catch(e){} }
            const storedAtt = localStorage.getItem('app_my_attendance');
            if (storedAtt) { try { myAttendanceHistory = JSON.parse(storedAtt); } catch(e){} }
            const storedAttSheet = localStorage.getItem('app_attendance_sheet');
            if (storedAttSheet) { try { attendanceData = JSON.parse(storedAttSheet); } catch(e){} }
        }

        function saveToStorage() {
            localStorage.setItem('app_leaves', JSON.stringify(leaveRequests));
            localStorage.setItem('app_my_attendance', JSON.stringify(myAttendanceHistory));
        }

        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            let bgClass = type === 'success' ? 'bg-emerald-600' : (type === 'error' ? 'bg-rose-600' : 'bg-indigo-600');
            toast.className = `${bgClass} text-white px-4 py-2.5 rounded-xl shadow-lg text-xs font-semibold transition-all opacity-0 translate-y-2`;
            toast.innerText = message;
            container.appendChild(toast);
            setTimeout(() => { toast.classList.remove('opacity-0', 'translate-y-2'); }, 50);
            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        function checkSession() {
            const session = localStorage.getItem('current_session');
            if (session) {
                try {
                    currentUser = JSON.parse(session);
                    showDashboard();
                } catch(e) { handleLogout(); }
            } else {
                showAuth();
            }
        }

        function showAuth() {
            document.getElementById('authContainer').classList.remove('hidden');
            document.getElementById('dashboardContainer').classList.add('hidden');
            document.getElementById('appHeader').classList.add('hidden');
        }

        function showDashboard() {
            if (!currentUser) return;
            document.getElementById('authContainer').classList.add('hidden');
            document.getElementById('dashboardContainer').classList.remove('hidden');
            document.getElementById('appHeader').classList.remove('hidden');

            document.getElementById('currentUserName').innerText = currentUser.name;
            document.getElementById('currentUserRole').innerText = currentUser.type;
            document.getElementById('userAvatar').innerText = currentUser.name.charAt(0).toUpperCase();

            const btnAdd = document.getElementById('btnAddUser');
            const roleFilter = document.getElementById('roleFilter');

            if (currentUser.type === 'Admin') {
                if (btnAdd) btnAdd.style.display = 'flex';
                if (roleFilter) roleFilter.classList.remove('hidden');
            } else {
                if (btnAdd) btnAdd.style.display = 'none';
                if (roleFilter) roleFilter.classList.add('hidden');
            }

            updateDashboardSummary();
            renderTableData();
        }

        function updateDashboardSummary() {
            if (!currentUser) return;
            const now = new Date();
            const currentYear = now.getFullYear();
            const currentMonth = now.getMonth();

            const userAtt = myAttendanceHistory.filter(a => {
                if (a.userId !== currentUser.id) return false;
                const attDate = new Date(a.timestamp);
                return attDate.getFullYear() === currentYear && attDate.getMonth() === currentMonth;
            });

            const checkIns = userAtt.filter(a => a.action === 'IN').length;
            const checkOuts = userAtt.filter(a => a.action === 'OUT').length;

            const userLeaves = leaveRequests.filter(l => {
                if (currentUser.type === 'BA Staff' && l.userId !== currentUser.id) return false;
                if (!l.startDate) return false;
                const leaveDate = new Date(l.startDate);
                return leaveDate.getFullYear() === currentYear && leaveDate.getMonth() === currentMonth;
            });

            if(document.getElementById('statCheckInCount')) document.getElementById('statCheckInCount').innerText = checkIns;
            if(document.getElementById('statCheckOutCount')) document.getElementById('statCheckOutCount').innerText = checkOuts;
            if(document.getElementById('statTotalLeaves')) document.getElementById('statTotalLeaves').innerText = userLeaves.length;
            if(document.getElementById('statPendingLeaves')) document.getElementById('statPendingLeaves').innerText = userLeaves.filter(l => l.status === 'Pending').length;
        }

        function handleLogout() {
            localStorage.removeItem('current_session');
            currentUser = null;
            showAuth();
        }

        function toggleAuthMode(mode) {
            if (mode === 'register') {
                document.getElementById('loginForm').classList.add('hidden');
                document.getElementById('registerForm').classList.remove('hidden');
                document.getElementById('authTitle').innerText = 'ចុះឈ្មោះបង្កើតគណនី';
            } else {
                document.getElementById('registerForm').classList.add('hidden');
                document.getElementById('loginForm').classList.remove('hidden');
                document.getElementById('authTitle').innerText = 'ចូលប្រើប្រាស់ប្រព័ន្ធ';
            }
        }

        function checkRegisterTypeSelection() {
            const typeVal = document.getElementById('regType').value;
            const container = document.getElementById('regManagerIdContainer');
            const select = document.getElementById('regManagerId');
            if (typeVal === 'Admin') {
                select.value = ""; select.required = false; container.style.display = 'none';
            } else {
                select.required = true; container.style.display = 'block';
            }
        }

        function switchMainTab(tab) {
            currentMainTab = tab;
            const btnStaff = document.getElementById('btnTabStaff');
            const btnLeave = document.getElementById('btnTabLeave');
            const btnReport = document.getElementById('btnTabReport');

            if(btnStaff) btnStaff.className = 'flex-1 sm:flex-initial px-3 py-1.5 text-slate-700 text-xs font-semibold rounded-lg transition';
            if(btnLeave) btnLeave.className = 'flex-1 sm:flex-initial px-3 py-1.5 text-slate-700 text-xs font-semibold rounded-lg transition';
            if(btnReport) btnReport.className = 'flex-1 sm:flex-initial px-3 py-1.5 text-slate-700 text-xs font-semibold rounded-lg transition';

            if (tab === 'staff' && btnStaff) {
                btnStaff.className = 'flex-1 sm:flex-initial px-3 py-1.5 bg-brand-600 text-white text-xs font-semibold rounded-lg shadow-sm transition';
            } else if (tab === 'leave' && btnLeave) {
                btnLeave.className = 'flex-1 sm:flex-initial px-3 py-1.5 bg-brand-600 text-white text-xs font-semibold rounded-lg shadow-sm transition';
            } else if (tab === 'report' && btnReport) {
                btnReport.className = 'flex-1 sm:flex-initial px-3 py-1.5 bg-brand-600 text-white text-xs font-semibold rounded-lg shadow-sm transition';
            }

            const roleFilter = document.getElementById('roleFilter');
            const leaveTypeFilter = document.getElementById('leaveTypeFilter');

            if (tab === 'staff') {
                if (currentUser && currentUser.type === 'Admin') roleFilter.classList.remove('hidden');
                if (leaveTypeFilter) leaveTypeFilter.classList.add('hidden');
            } else if (tab === 'leave') {
                if (roleFilter) roleFilter.classList.add('hidden');
                if (leaveTypeFilter) leaveTypeFilter.classList.remove('hidden');
            } else {
                if (roleFilter) roleFilter.classList.add('hidden');
                if (leaveTypeFilter) leaveTypeFilter.classList.add('hidden');
            }

            renderTableData();
        }

        function handleLogin(e) {
            e.preventDefault();
            const id = document.getElementById('loginId').value.trim();
            const pass = document.getElementById('loginPassword').value.trim();
            
            const user = users.find(u => u.id === id && u.password === pass);
            if (user) {
                currentUser = user;
                localStorage.setItem('current_session', JSON.stringify(user));
                showDashboard();
                showToast("ចូលប្រព័ន្ធបានជោគជ័យ!", "success");
            } else {
                showToast("អត្តលេខ ឬ ពាក្យសម្ងាត់មិនត្រឹមត្រូវ!", "error");
            }
        }

        async function handleRegister(e) {
            e.preventDefault();
            const id = document.getElementById('regId').value.trim();
            if (users.some(u => u.id === id)) {
                showToast("អត្តលេខនេះមានរួចហើយ!", "error");
                return;
            }
            const typeVal = document.getElementById('regType').value;
            const newUser = {
                id: id,
                name: document.getElementById('regName').value.trim(),
                password: document.getElementById('regPassword').value.trim(),
                location: document.getElementById('regLocation').value.trim(),
                startDate: document.getElementById('regStartDate').value,
                status: document.getElementById('regStatus').value,
                type: typeVal,
                managerId: typeVal === 'Admin' ? '' : document.getElementById('regManagerId').value
            };
            users.push(newUser);
            toggleAuthMode('login');
            showToast("ចុះឈ្មោះបានជោគជ័យ!", "success");

            try {
                await fetch(GOOGLE_SHEET_API_URL, {
                    method: "POST", mode: "no-cors",
                    headers: { "Content-Type": "text/plain;charset=utf-8" },
                    body: JSON.stringify({ type: "user_action", user: newUser })
                });
            } catch(e) {}
        }

        function getGPSLocation(targetId) {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(pos => {
                    const coords = `${pos.coords.latitude.toFixed(6)},${pos.coords.longitude.toFixed(6)}`;
                    document.getElementById(targetId).value = coords;
                    showToast("ទាញយក GPS បានជោគជ័យ!", "success");
                }, () => { showToast("មិនអាចទាញយក GPS បានទេ", "error"); });
            } else {
                showToast("ឧបករណ៍របស់អ្នកមិនគាំទ្រ GPS", "error");
            }
        }

        function openMapModal(targetId) {
            targetLocationInputId = targetId;
            document.getElementById('mapModal').classList.remove('hidden');
            setTimeout(() => {
                if (!mapInstance) {
                    mapInstance = L.map('mapPicker').setView([11.5564, 104.9282], 13);
