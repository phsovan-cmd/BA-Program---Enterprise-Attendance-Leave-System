    <!-- MAP MODAL -->
    <div id="mapModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-md z-50 flex items-center justify-center p-3 sm:p-4 hidden">
        <div class="bg-white rounded-3xl shadow-2xl max-w-lg w-full border p-3">
            <div class="px-3 py-2.5 flex justify-between items-center border-b">
                <h3 class="font-bold text-slate-800 text-sm sm:text-base">ជ្រើសរើសទីតាំងលើផែនទី</h3>
                <button onclick="closeMapModal()" class="text-slate-400"><i data-lucide="x" class="w-5 h-5"></i></button>
            </div>
            <div class="p-2"><div id="mapPicker"></div></div>
            <div class="p-2.5 border-t flex justify-end gap-2">
                <button type="button" onclick="closeMapModal()" class="px-4 py-2 border rounded-xl text-xs sm:text-sm">បោះបង់</button>
                <button type="button" onclick="confirmMapLocation()" class="px-4 py-2 bg-brand-600 text-white rounded-xl text-xs sm:text-sm font-semibold">យល់ព្រម</button>
            </div>
