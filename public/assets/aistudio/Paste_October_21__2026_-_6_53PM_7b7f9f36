                        <td class="py-3 px-3 font-bold text-brand-600">${l.userName} (${l.userId})</td>
                        <td class="py-3 px-3"><span class="px-2 py-0.5 bg-pink-50 text-pink-600 rounded text-xs font-bold">${l.type}</span></td>
                        <td class="py-3 px-3 text-[11px] sm:text-xs text-slate-600">${l.startDate} ➔ ${l.endDate}</td>
                        <td class="py-3 px-3">${badge}</td>
                        <td class="py-3 px-3 text-right space-x-1">
                            ${canApprove ? `
                                <button onclick="approveLeave('${l.id}')" class="px-2 py-1 bg-emerald-600 text-white rounded text-[11px] font-semibold">Approve</button>
                                <button onclick="rejectLeave('${l.id}')" class="px-2 py-1 bg-rose-600 text-white rounded text-[11px] font-semibold">Reject</button>
                            ` : `<span class="text-[11px] text-slate-400">-</span>`}
                        </td>
                    </tr>`;
                });
                html += `</tbody>`;
                table.innerHTML = html;
            }
        }

        async function deleteUser(id) {
            if (!currentUser || currentUser.type !== 'Admin') return;
            if (confirm("តើអ្នកពិតជាចង់លុបទិន្នន័យនេះមែនទេ?")) {
                users = users.filter(u => u.id !== id);
                renderTableData();
                showToast("លុបបានជោគជ័យ!", "info");
                try {
                    await fetch(`${GOOGLE_SHEET_API_URL}?type=delete_user&userId=${encodeURIComponent(id)}`, { method: "GET", mode: "no-cors" });
                } catch (error) {}
            }
        }

        function checkUserTypeSelection() {
            const typeVal = document.getElementById('mType').value;
            const container = document.getElementById('managerIdContainer');
            const select = document.getElementById('mManagerId');
            if (typeVal === 'Admin') {
                select.value = ""; select.required = false; container.style.display = 'none';
            } else {
                select.required = true; container.style.display = 'block';
            }
        }

        function openAddUserModal() {
            document.getElementById('modalTitle').innerText = 'បន្ថែមបុគ្គលិកថ្មី';
            document.getElementById('modalForm').reset();
            document.getElementById('modalEditIndex').value = -1;
            document.getElementById('mId').disabled = false;
            document.getElementById('managerIdContainer').style.display = 'block';
            document.getElementById('mManagerId').required = true;
            document.getElementById('userModal').classList.remove('hidden');
        }

        function openEditUserModal(index) {
            const user = users[index];
            if (!user) return;
            document.getElementById('modalTitle').innerText = 'កែប្រែព័ត៌មានបុគ្គលិក';
            document.getElementById('modalEditIndex').value = index;
            document.getElementById('mId').value = user.id;
            document.getElementById('mId').disabled = true;
            document.getElementById('mName').value = user.name;
            document.getElementById('mPassword').value = '';
            document.getElementById('mLocation').value = user.location;
            
            if (user.startDate) {
                document.getElementById('mStartDate').value = formatDateForInput(user.startDate);
            } else {
                document.getElementById('mStartDate').value = '';
            }

            document.getElementById('mStatus').value = user.status;
            document.getElementById('mType').value = user.type;
            document.getElementById('mManagerId').value = user.managerId || '';
            checkUserTypeSelection();
            document.getElementById('userModal').classList.remove('hidden');
        }

        function formatDateForInput(dateString) {
            if (!dateString) return '';
            let d = new Date(dateString);
            if (isNaN(d.getTime())) return dateString; 
            
            let year = d.getFullYear();
            let month = String(d.getMonth() + 1).padStart(2, '0');
            let day = String(d.getDate()).padStart(2, '0');
            
            return `${year}-${month}-${day}`;
        }

        function closeUserModal() { document.getElementById('userModal').classList.add('hidden'); }

        async function handleSaveModalUser(event) {
            event.preventDefault();
            const editIndex = parseInt(document.getElementById('modalEditIndex').value);
            const id = document.getElementById('mId').value.trim();
            const typeVal = document.getElementById('mType').value;
            
            const userData = {
                id: id,
                name: document.getElementById('mName').value.trim(),
                password: document.getElementById('mPassword').value.trim(),
                location: document.getElementById('mLocation').value.trim(),
                startDate: document.getElementById('mStartDate').value,
                status: document.getElementById('mStatus').value,
                type: typeVal,
                managerId: typeVal === 'Admin' ? '' : document.getElementById('mManagerId').value
            };

            if (editIndex !== -1) {
                if(!userData.password) {
                    userData.password = users[editIndex].password;
                }
                users[editIndex] = userData;
            } else {
                users.push(userData);
            }

            closeUserModal();
            renderTableData();
            showToast("រក្សាទុកបានជោគជ័យ!", "success");

            try {
                await fetch(GOOGLE_SHEET_API_URL, {
                    method: "POST", mode: "no-cors",
                    headers: { "Content-Type": "text/plain;charset=utf-8" },
                    body: JSON.stringify({ type: "sync_users", user: userData })
                });
            } catch(e) {}
        }
    </script>
</body>
</html>