<!DOCTYPE html>
<html lang="km">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BA Program - Standard Enterprise</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Leaflet / OpenStreetMap Integration -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Kantumruy+Pro:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'Kantumruy Pro', 'sans-serif'] },
                    colors: {
                        brand: { 50: '#eef2ff', 100: '#e0e7ff', 500: '#6366f1', 600: '#4f46e5', 700: '#4338ca', 900: '#312e81' }
                    },
                    boxShadow: {
                        '3d': '0 10px 25px -5px rgba(79, 70, 229, 0.2), 0 8px 10px -6px rgba(79, 70, 229, 0.1)',
                        '3d-card': '0 20px 30px -5px rgba(0, 0, 0, 0.08), 0 10px 15px -5px rgba(0, 0, 0, 0.04)',
                        '3d-alert': '0 15px 35px -5px rgba(99, 102, 241, 0.25), inset 0 2px 4px rgba(255, 255, 255, 0.6)'
                    }
                }
            }
        }
    </script>
    <style>
        ::-webkit-scrollbar { width: 4px; height: 4px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        #mapPicker { height: 260px; width: 100%; border-radius: 0.75rem; }
        .card-3d { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .card-3d:hover { transform: translateY(-3px); box-shadow: 0 20px 30px -10px rgba(79, 70, 229, 0.2); }
        .alert-3d {
            background: linear-gradient(135deg, rgba(255,255,255,0.9) 0%, rgba(241,245,249,0.8) 100%);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), inset 0 1px 1px rgba(255, 255, 255, 0.8);
            border-left: 4px solid #6366f1;
        }
     
        /* ធានាថា container របស់តារាងមានកន្លែង Scroll ស្រួល */
        .overflow-x-auto {
            max-height: 600px; /* កម្ពស់តារាងតាមតម្រូវការ */
            overflow: auto;
        }

        /* Freeze ក្បាលតារាង (Header ថ្ងៃទី ១ ដល់ ៣១) ជាប់ខាងលើពេល Scroll ចុះក្រោម */
        #mainTable thead th {
            position: sticky;
            top: 0;
            z-index: 20;
            background-color: #f8fafc; /* ពណ៌ផ្ទៃខាងក្រោយក្បាលតារាង */
        }

        /* Freeze ជួរឈរទី ១ (BA ID & Name) ជាប់ខាងឆ្វេងពេល Scroll ไปស្តាំ */
        #mainTable th:first-child,
        #mainTable td:first-child {
            position: sticky;
            left: 0;
            z-index: 10;
            background-color: #ffffff; /* ពណ៌ផ្ទៃខាងក្រោយពេលជាប់នឹងកន្លែង */
            box-shadow: 2px 0 5px -2px rgba(0, 0, 0, 0.05); /* បង្កើតស្រមោលបន្តិចដើម្បីឱ្យដាច់ពីកន្លែងផ្សេង */
        }

        /* ករណីក្បាលតារាងជួរបញ្اطعគ្នានៅជ្រុងខាងឆ្វេង (BA ID & Name header) ឱ្យវាមាន z-index ខ្ពស់ជាងគេ */
        #mainTable thead th:first-child {
            z-index: 30;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-slate-50 via-indigo-50/20 to-slate-100 font-sans text-slate-800 antialiased min-h-screen flex flex-col justify-between">

    <div id="toastContainer" class="fixed top-4 right-4 left-4 sm:left-auto z-50 flex flex-col gap-2 pointer-events-none"></div>

    <div id="app" class="flex-grow flex flex-col">
        <!-- NAVBAR -->
        <nav id="appHeader" class="hidden bg-white/90 backdrop-blur-md border-b border-slate-200/80 sticky top-0 z-40 shadow-sm">
            <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
                <div class="flex justify-between items-center h-16">
                    <div class="flex items-center space-x-2.5">
                        <div class="p-2.5 bg-gradient-to-tr from-brand-600 to-indigo-500 text-white rounded-xl shadow-3d">
                            <i data-lucide="box" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <span class="font-bold text-base sm:text-lg text-slate-900 tracking-tight block leading-none">BA Program</span>
                            <span class="text-[10px] text-slate-500 font-normal">ប្រព័ន្ធគ្រប់គ្រងស្ដង់ដារ</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 sm:gap-4">
                        <button id="installAppBtn" onclick="installApp()" class="hidden items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-white bg-gradient-to-r from-emerald-600 to-teal-600 rounded-xl shadow-md transition-all hover:opacity-90">
                            <i data-lucide="download" class="w-4 h-4"></i>
                            <span class="hidden sm:inline">Install App</span>
                        </button>

                        <div id="currentUserBadge" class="flex items-center gap-2 px-3 py-1.5 bg-slate-50 rounded-xl border border-slate-200 shadow-sm">
                            <div class="w-7 h-7 rounded-lg bg-gradient-to-tr from-brand-500 to-indigo-600 text-white flex items-center justify-center font-bold text-xs shadow" id="userAvatar">U</div>
                            <div class="text-left hidden sm:block">
                                <p id="currentUserName" class="text-xs font-semibold text-slate-800 leading-tight">User Name</p>
                                <p id="currentUserRole" class="text-[10px] text-brand-600 uppercase tracking-wider font-bold">Admin</p>
                            </div>
                        </div>
                        <button onclick="handleLogout()" class="inline-flex items-center gap-1 p-2 sm:px-3 sm:py-2 text-xs font-medium text-rose-600 bg-rose-50 hover:bg-rose-100 rounded-xl transition-all shadow-sm border border-rose-200">
                            <i data-lucide="log-out" class="w-4 h-4"></i>
                            <span class="hidden sm:inline">ចាកចេញ</span>
                        </button>
                    </div>
                </div>
            </div>
        </nav>

        <!-- AUTH CONTAINER -->
        <div id="authContainer" class="flex-grow flex items-center justify-center p-3 sm:p-6">
            <div class="w-full max-w-md bg-white/95 backdrop-blur-xl rounded-3xl shadow-3d-card border border-white/80 overflow-hidden p-2">
                <div class="bg-gradient-to-tr from-brand-600 via-indigo-600 to-purple-600 p-5 sm:p-6 text-white text-center relative rounded-2xl shadow-lg mb-3">
                    <div class="w-12 h-12 mx-auto mb-2.5 bg-white/20 backdrop-blur-md rounded-2xl flex items-center justify-center border border-white/30 shadow-inner">
                        <i data-lucide="box" class="w-6 h-6 text-white"></i>
                    </div>
                    <h1 id="authTitle" class="text-lg sm:text-xl font-bold tracking-wide">ចូលប្រើប្រាស់ប្រព័ន្ធ</h1>
                    <p id="authSubtitle" class="text-xs text-indigo-100 mt-0.5">សូមបញ្ចូលអត្តលេខ និងពាក្យសម្ងាត់របស់អ្នក</p>
                </div>

                <form id="loginForm" onsubmit="handleLogin(event)" class="p-3 sm:p-4 space-y-3.5">
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-700 uppercase tracking-wider mb-1">អត្តលេខ (User ID)</label>
                        <input type="text" id="loginId" required placeholder="ឧទាហរណ៍: BA00001" class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-500 shadow-sm">
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-700 uppercase tracking-wider mb-1">ពាក្យសម្ងាត់ (Password)</label>
                        <input type="password" id="loginPassword" required placeholder="••••••••" class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-500 shadow-sm">
                    </div>
                    <button type="submit" class="w-full py-3 px-4 bg-gradient-to-r from-brand-600 to-indigo-600 text-white text-sm font-semibold rounded-xl shadow-3d transition-all flex items-center justify-center gap-2">
                        <i data-lucide="log-in" class="w-4 h-4"></i>
                        <span>ចូលប្រព័ន្ធ (Log In)</span>
                    </button>
                    <div class="text-center pt-2 border-t border-slate-100">
                        <p class="text-xs text-slate-600">មិនទាន់មានគណនី? <button type="button" onclick="toggleAuthMode('register')" class="text-brand-600 font-bold hover:underline">ចុះឈ្មោះ</button></p>
                    </div>
                </form>

                <form id="registerForm" onsubmit="handleRegister(event)" class="p-3 sm:p-4 space-y-3 hidden">
                    <div class="grid grid-cols-2 gap-2.5">
                        <div><label class="block text-[11px] font-semibold text-slate-700 uppercase mb-1">ID *</label><input type="text" id="regId" required class="w-full px-3 py-2 text-sm bg-slate-50 border rounded-xl"></div>
                        <div><label class="block text-[11px] font-semibold text-slate-700 uppercase mb-1">Name *</label><input type="text" id="regName" required class="w-full px-3 py-2 text-sm bg-slate-50 border rounded-xl"></div>
                    </div>
                    <div><label class="block text-[11px] font-semibold text-slate-700 uppercase mb-1">Password *</label><input type="password" id="regPassword" required class="w-full px-3 py-2 text-sm bg-slate-50 border rounded-xl"></div>
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-700 uppercase mb-1">Location *</label>
                        <input type="text" id="regLocation" required class="w-full px-3 py-2 text-sm bg-slate-50 border rounded-xl">
                        <div class="flex gap-2 mt-1.5">
                            <button type="button" onclick="getGPSLocation('regLocation')" class="flex-1 py-1.5 bg-slate-100 text-xs font-medium rounded-xl border">យក GPS</button>
                            <button type="button" onclick="openMapModal('regLocation')" class="flex-1 py-1.5 bg-indigo-50 text-brand-700 text-xs font-medium rounded-xl border">ជ្រើស Map</button>
                        </div>
                    </div>
                    <div><label class="block text-[11px] font-semibold text-slate-700 uppercase mb-1">Start Date *</label><input type="date" id="regStartDate" required class="w-full px-3 py-2 text-sm bg-slate-50 border rounded-xl"></div>
                    <div class="grid grid-cols-2 gap-2.5">
                        <div><label class="block text-[11px] font-semibold text-slate-700 uppercase mb-1">Status *</label><select id="regStatus" class="w-full px-3 py-2 text-sm bg-slate-50 border rounded-xl"><option value="Active">Active</option><option value="Pending">Pending</option></select></div>
                        <div><label class="block text-[11px] font-semibold text-slate-700 uppercase mb-1">Type *</label><select id="regType" onchange="checkRegisterTypeSelection()" class="w-full px-3 py-2 text-sm bg-slate-50 border rounded-xl"><option value="BA Staff">BA Staff</option><option value="Manager">Manager</option><option value="Admin">Admin</option></select></div>
                    </div>
                    <div id="regManagerIdContainer">
                        <label class="block text-[11px] font-semibold text-slate-700 uppercase mb-1">Manager ID *</label>
                        <select id="regManagerId" required class="w-full px-3 py-2 text-sm bg-slate-50 border rounded-xl">
                            <option value="">-- ជ្រើសរើស Manager ID --</option>
                            <option value="DTPP1">DTPP1</option><option value="DTPP2">DTPP2</option><option value="DTPP3">DTPP3</option>
                            <option value="DTKD">DTKD</option><option value="DTPV">DTPV</option><option value="DTKC">DTKC</option>
                        </select>
                    </div>
                    <button type="submit" class="w-full py-2.5 bg-gradient-to-r from-brand-600 to-indigo-600 text-white text-sm font-semibold rounded-xl shadow-3d mt-1">បង្កើតគណនី</button>
                    <div class="text-center pt-1.5 border-t"><p class="text-xs text-slate-600">មានគណនីរួចហើយ? <button type="button" onclick="toggleAuthMode('login')" class="text-brand-600 font-bold hover:underline">ចូលប្រព័ន្ធ</button></p></div>
                </form>
            </div>
        </div>

        <!-- DASHBOARD -->
        <main id="dashboardContainer" class="hidden flex-grow max-w-7xl w-full mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-6 space-y-4 sm:space-y-6">
            
            <div class="alert-3d p-4 rounded-2xl flex items-start gap-3 shadow-sm relative overflow-hidden">
                <div class="p-2 bg-indigo-600 text-white rounded-xl shadow-md shrink-0">
                    <i data-lucide="info" class="w-5 h-5"></i>
                </div>
                <div class="flex-grow">
                    ព័ត៌មានប្រព័ន្ធ: មន្ត្រី BA ទាំងអស់តម្រូវឱ្យ Check-In ក្នុងចំងាយ ១០ ម៉ែត្រពីទីតាំងតូប និងគ្រប់គ្រងសំណើច្បាប់តាមស្ដង់ដារ។
                </div>
            </div>

            <!-- DASHBOARD SUMMARY CARDS -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
                <div class="bg-white/90 backdrop-blur-xl p-4 rounded-2xl border shadow-sm flex items-center gap-3">
                    <div class="p-3 bg-emerald-50 text-emerald-600 rounded-xl"><i data-lucide="log-in" class="w-5 h-5"></i></div>
                    <div>
                        <p class="text-[11px] text-slate-500 font-medium">Check-In ប្រចាំខែ</p>
                        <h4 id="statCheckInCount" class="text-base sm:text-lg font-bold text-slate-800">0</h4>
                    </div>
                </div>
                <div class="bg-white/90 backdrop-blur-xl p-4 rounded-2xl border shadow-sm flex items-center gap-3">
                    <div class="p-3 bg-rose-50 text-rose-600 rounded-xl"><i data-lucide="log-out" class="w-5 h-5"></i></div>
                    <div>
                        <p class="text-[11px] text-slate-500 font-medium">Check-Out ប្រចាំខែ</p>
                        <h4 id="statCheckOutCount" class="text-base sm:text-lg font-bold text-slate-800">0</h4>
                    </div>
                </div>
                <div class="bg-white/90 backdrop-blur-xl p-4 rounded-2xl border shadow-sm flex items-center gap-3">
                    <div class="p-3 bg-pink-50 text-pink-600 rounded-xl"><i data-lucide="file-text" class="w-5 h-5"></i></div>
                    <div>
                        <p class="text-[11px] text-slate-500 font-medium">សំណើច្បាប់ប្រចាំខែ</p>
                        <h4 id="statTotalLeaves" class="text-base sm:text-lg font-bold text-slate-800">0</h4>
                    </div>
                </div>
                <div class="bg-white/90 backdrop-blur-xl p-4 rounded-2xl border shadow-sm flex items-center gap-3">
                    <div class="p-3 bg-amber-50 text-amber-600 rounded-xl"><i data-lucide="clock" class="w-5 h-5"></i></div>
                    <div>
                        <p class="text-[11px] text-slate-500 font-medium">កំពុងរង់ចាំ (Pending)</p>
                        <h4 id="statPendingLeaves" class="text-base sm:text-lg font-bold text-slate-800">0</h4>
                    </div>
                </div>
            </div>

            <!-- Top Widgets Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6">
                <!-- Check-in / Check-out Panel -->
                <div class="bg-white/90 backdrop-blur-xl p-4 sm:p-6 rounded-3xl border shadow-3d-card card-3d flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-3">
                            <h3 class="font-bold text-slate-800 text-sm sm:text-base flex items-center gap-2">
                                <div class="p-2 bg-brand-50 text-brand-600 rounded-xl"><i data-lucide="map-pin" class="w-4 h-4"></i></div>
                                <span>ចុះវត្តមាន (Check-In / Out)</span>
                            </h3>
                            <span id="checkInStatusBadge" class="text-[10px] sm:text-xs px-2.5 py-1 rounded-full bg-slate-100 text-slate-600 font-semibold">មិនទាន់ Check-In</span>
                        </div>
                        <p class="text-[11px] sm:text-xs text-slate-500 mb-4">អ្នកត្រូវស្ថិតក្នុងចំចម្ងាយ <b>១០ ម៉ែត្រ</b> ពីទីតាំងតូប។</p>
                    </div>
                    <div class="grid grid-cols-2 gap-2 sm:gap-3">
                        <button onclick="performCheckIn('IN')" class="py-2.5 sm:py-3 bg-gradient-to-r from-emerald-600 to-teal-600 text-white font-semibold text-xs sm:text-sm rounded-2xl shadow flex items-center justify-center gap-1.5"><i data-lucide="log-in" class="w-4 h-4"></i><span>Check In</span></button>
                        <button onclick="performCheckIn('OUT')" class="py-2.5 sm:py-3 bg-gradient-to-r from-rose-600 to-pink-600 text-white font-semibold text-xs sm:text-sm rounded-2xl shadow flex items-center justify-center gap-1.5"><i data-lucide="log-out" class="w-4 h-4"></i><span>Check Out</span></button>
                    </div>
                </div>

                <!-- Leave Requests Button Types (9 Types) -->
                <div class="lg:col-span-2 bg-white/90 backdrop-blur-xl p-4 sm:p-6 rounded-3xl border shadow-3d-card card-3d">
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="font-bold text-slate-800 text-sm sm:text-base flex items-center gap-2">
                            <div class="p-2 bg-pink-50 text-pink-600 rounded-xl"><i data-lucide="calendar-off" class="w-4 h-4"></i></div>
                            <span>ស្នើសុំច្បាប់សម្រាក (Leave Types)</span>
                        </h3>
                        <span class="text-[10px] sm:text-xs text-slate-400 bg-slate-100 px-2 py-0.5 rounded-lg">9 ប្រភេទ</span>
                    </div>
                    <div class="grid grid-cols-3 sm:grid-cols-9 gap-1.5 sm:gap-2">
                        <button onclick="openLeaveModal('TI')" class="py-2.5 sm:py-3 border bg-gradient-to-b from-pink-50/50 to-white text-pink-600 font-bold rounded-xl text-xs sm:text-sm hover:bg-pink-50">TI</button>
                        <button onclick="openLeaveModal('CS')" class="py-2.5 sm:py-3 border bg-gradient-to-b from-pink-50/50 to-white text-pink-600 font-bold rounded-xl text-xs sm:text-sm hover:bg-pink-50">CS</button>
                        <button onclick="openLeaveModal('AL')" class="py-2.5 sm:py-3 border bg-gradient-to-b from-pink-50/50 to-white text-pink-600 font-bold rounded-xl text-xs sm:text-sm hover:bg-pink-50">AL</button>
                        <button onclick="openLeaveModal('UL')" class="py-2.5 sm:py-3 border bg-gradient-to-b from-pink-50/50 to-white text-pink-600 font-bold rounded-xl text-xs sm:text-sm hover:bg-pink-50">UL</button>
                        <button onclick="openLeaveModal('SL')" class="py-2.5 sm:py-3 border bg-gradient-to-b from-pink-50/50 to-white text-pink-600 font-bold rounded-xl text-xs sm:text-sm hover:bg-pink-50">SL</button>
                        <button onclick="openLeaveModal('SPL')" class="py-2.5 sm:py-3 border bg-gradient-to-b from-pink-50/50 to-white text-pink-600 font-bold rounded-xl text-xs sm:text-sm hover:bg-pink-50">SPL</button>
                        <button onclick="openLeaveModal('C-O')" class="py-2.5 sm:py-3 border bg-gradient-to-b from-pink-50/50 to-white text-pink-600 font-bold rounded-xl text-xs sm:text-sm hover:bg-pink-50">C-O</button>
                        <button onclick="openLeaveModal('PH')" class="py-2.5 sm:py-3 border bg-gradient-to-b from-pink-50/50 to-white text-pink-600 font-bold rounded-xl text-xs sm:text-sm hover:bg-pink-50">PH</button>
                        <button onclick="openLeaveModal('Off')" class="py-2.5 sm:py-3 border bg-gradient-to-b from-pink-50/50 to-white text-pink-600 font-bold rounded-xl text-xs sm:text-sm hover:bg-pink-50">Off</button>
                    </div>
                </div>
            </div>

            <!-- Table & Switch Tabs Section -->
            <div class="bg-white/90 backdrop-blur-xl rounded-3xl shadow-3d-card border overflow-hidden">
                <div class="p-4 sm:p-6 border-b flex flex-col gap-3 sm:flex-row sm:items-center justify-between">
                    <div>
                        <h2 class="text-base sm:text-lg font-bold text-slate-800 flex items-center gap-2">
                            <span id="tableTitleText">របាយការណ៍ការងារប្រចាំថ្ងៃ តាម User BA Staff (ប្រចាំខែ)</span>
