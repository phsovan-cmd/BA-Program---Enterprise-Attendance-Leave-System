        function performCheckIn(action) {
            if (!currentUser) return;

            // ១. ពិនិត្យមើលថាតើ User ມີ Location ដែរឬទេ
            if (!currentUser.location || !currentUser.location.includes(',')) {
                showToast("គណនីរបស់អ្នកពុំទាន់មានទីតាំង (Location) ស្ដង់ដារទេ!", "error");
                return;
            }

            // យក Latitude និង Longitude របស់តូប (ពី Profile User)
            const [shopLat, shopLng] = currentUser.location.split(',').map(Number);

            // ២. ទាញយក GPS បច្ចុប្បន្នរបស់អ្នកប្រើប្រាស់
            if (!navigator.geolocation) {
                showToast("ឧបករណ៍របស់អ្នកមិនគាំទ្រ GPS ទេ។", "error");
                return;
            }

            showToast("កំពុងពិនិត្យទីតាំង GPS...", "info");

            navigator.geolocation.getCurrentPosition(position => {
                const userLat = position.coords.latitude;
                const userLng = position.coords.longitude;

                // ៣. គណនាចម្ងាយជាម៉ែត្រ (ប្រើប្រាស់ Haversine Formula)
                const distance = calculateDistanceMeters(shopLat, shopLng, userLat, userLng);

                // ៤. ផ្ទៀងផ្ទាត់ចម្ងាយ (កំណត់ត្រឹម ១០ ម៉ែត្រ តាមតម្រូវការ)
                const ALLOWED_DISTANCE = 10; // ជាម៉ែត្រ

                if (distance > ALLOWED_DISTANCE) {
                    showToast(`មិនអាច Check-${action} បានទេ! អ្នកនៅឆ្ងាយពីទីតាំងតូបចម្ងាយ ${Math.round(distance)} ម៉ែត្រ (ហាមឃាត់លើសពី ${ALLOWED_DISTANCE}ម)`, "error");
                    return;
                }

                // ៥. ប្រសិនបើនៅក្នុងចម្ងាយកំណត់ ទើបអនុញ្ញាតឱ្យ Check-In / Check-Out ធម្មតា
                const now = new Date().toISOString(); 
                
                myAttendanceHistory.push({
                    userId: currentUser.id,
                    action: action,
                    timestamp: now
                });
                saveToStorage();
                updateDashboardSummary();

                sendReportToGoogleSheet(action, `Check-${action} at ${new Date().toLocaleString()}`);
                if(document.getElementById('checkInStatusBadge')) {
                    document.getElementById('checkInStatusBadge').innerText = `បាន Check-${action}`;
                    document.getElementById('checkInStatusBadge').className = action === 'IN' ? 'text-[10px] sm:text-xs px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-700 font-semibold' : 'text-[10px] sm:text-xs px-2.5 py-1 rounded-full bg-rose-100 text-rose-700 font-semibold';
                }
                showToast(`Check-${action} បានជោគជ័យ!`, "success");

            }, error => {
                showToast("មិនអាចទាញយកទីតាំង GPS របស់អ្នកបានទេ. សូមបើក GPS ជាមុនសិន!", "error");
            }, { enableHighAccuracy: true });
        }

// មុខងារគណនាចម្ងាយជាម៉ែត្ររវាងចំណុច GPS ពីរ
function calculateDistanceMeters(lat1, lon1, lat2, lon2) {
    const R = 6371e3; // รัศมีផែនដីគិតជាម៉ែត្រ
    const φ1 = lat1 * Math.PI/180;
    const φ2 = lat2 * Math.PI/180;
    const Δφ = (lat2-lat1) * Math.PI/180;
    const Δλ = (lon2-lon1) * Math.PI/180;

    const a = Math.sin(Δφ/2) * Math.sin(Δφ/2) +
              Math.cos(φ1) * Math.cos(φ2) *
              Math.sin(Δλ/2) * Math.sin(Δλ/2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));

    return R * c; // ចម្ងាយគិតជាម៉ែត្រ
}

